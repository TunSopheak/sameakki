# Copy to .env. Never commit .env.

PORT=3000
NODE_ENV=development

# Required in production: 32+ random characters
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7

# PostgreSQL connection string, for example:
# postgresql://postgres:PASSWORD@localhost:5432/sameakki
# Empty = embedded test database in ./data (not for production)
DATABASE_URL=
# Use false for a local PostgreSQL without SSL. On by default in production.
# DATABASE_SSL=false

# Only if the frontend is on another domain
# CORS_ORIGINS=https://frontend.example.com
# VITE_API_URL=https://api.example.com
# Only if you serve over plain HTTP
# COOKIE_SECURE=false
